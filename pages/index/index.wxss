.header {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
}

.greeting {
  text-align: center;
  margin-bottom: 30rpx;
}

.greeting-text {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.mood-score {
  text-align: center;
}

.score-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.score-value {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.score-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.quick-actions {
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.action-grid {
  display: flex;
  justify-content: space-around;
}

.action-item {
  text-align: center;
  padding: 20rpx;
}

.action-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-bottom: 15rpx;
}

.text-icon {
  background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
}

.voice-icon {
  background: linear-gradient(135deg, #fd79a8 0%, #e84393 100%);
}

.face-icon {
  background: linear-gradient(135deg, #55efc4 0%, #00b894 100%);
}

.action-label {
  font-size: 26rpx;
  color: #666;
}

.today-summary {
  padding: 30rpx;
}

.record-list {
  margin-top: 10rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-emotion {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.record-content {
  flex: 1;
}

.record-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 60rpx 30rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.tips {
  padding: 30rpx;
}

.tip-content {
  background: #f8f9fa;
  padding: 25rpx;
  border-radius: 15rpx;
  border-left: 6rpx solid #6c5ce7;
}

.tip-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}