.container {
  padding: 20rpx;
}

.header {
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  margin-right: 25rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.mood-badge {
  position: absolute;
  bottom: -5rpx;
  right: -5rpx;
  width: 36rpx;
  height: 36rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mood-icon {
  font-size: 20rpx;
}

.user-details {
  flex: 1;
}

.username {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-motto {
  font-size: 24rpx;
  opacity: 0.9;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
}

.settings-section,
.tools-section,
.support-section,
.about-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 25rpx;
  color: #333;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-icon {
  font-size: 36rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.setting-value {
  font-size: 26rpx;
  color: #999;
}

.setting-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tool-item {
  width: calc(50% - 10rpx);
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.tool-icon {
  font-size: 40rpx;
}

.tool-label {
  font-size: 26rpx;
  color: #333;
}

.support-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  padding: 25rpx;
  border-radius: 15rpx;
}

.support-left {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.support-icon {
  font-size: 40rpx;
}

.support-info {
  display: flex;
  flex-direction: column;
}

.support-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #e74c3c;
  margin-bottom: 5rpx;
}

.support-desc {
  font-size: 24rpx;
  color: #666;
}

.support-arrow {
  font-size: 24rpx;
  color: #999;
}

.about-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.about-item:last-child {
  border-bottom: none;
}

.about-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.about-icon {
  font-size: 32rpx;
}

.about-label {
  font-size: 28rpx;
  color: #333;
}

.about-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.version {
  text-align: center;
  padding: 30rpx;
}

.version-text {
  font-size: 24rpx;
  color: #ccc;
}