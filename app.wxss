page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #333;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: #6c5ce7;
}

.text-success {
  color: #00b894;
}

.text-warning {
  color: #fdcb6e;
}

.text-danger {
  color: #e17055;
}

.text-info {
  color: #74b9ff;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.emotion-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin: 5rpx;
}

.tag-positive {
  background: #d4edda;
  color: #155724;
}

.tag-negative {
  background: #f8d7da;
  color: #721c24;
}

.tag-neutral {
  background: #e2e3e5;
  color: #383d41;
}