.container {
  padding: 20rpx;
}

.date-selector {
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.date-tabs {
  display: flex;
  justify-content: space-around;
}

.date-tab {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.date-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  font-weight: bold;
}

.summary-cards {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.summary-card {
  flex: 1;
  padding: 25rpx 15rpx;
  text-align: center;
}

.summary-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.summary-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.summary-label {
  font-size: 22rpx;
  color: #999;
}

.chart-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.pie-chart {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.pie-container {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(
    #00b894 0deg 120deg,
    #e17055 120deg 200deg,
    #74b9ff 200deg 360deg
  );
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.pie-center {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-total {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.pie-label {
  font-size: 20rpx;
  color: #999;
}

.pie-legend {
  flex: 1;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.legend-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.line-chart {
  height: 300rpx;
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.chart-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  height: 1rpx;
  background: #e0e0e0;
}

.chart-lines {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 40rpx;
}

.line-series {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.line-path {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.data-points {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
}

.data-point {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6c5ce7;
  position: relative;
  pointer-events: none;
}

.line-series.positive .data-point {
  background: #00b894;
}

.line-series.negative .data-point {
  background: #e17055;
}

.chart-xaxis {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.xaxis-label {
  font-size: 20rpx;
  color: #999;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.chart-legend .legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.positive {
  background: #00b894;
}

.legend-dot.negative {
  background: #e17055;
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

.insights-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.insight-item {
  display: flex;
  gap: 20rpx;
}

.insight-icon {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
}

.insight-content {
  flex: 1;
}

.insight-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.insight-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty-state {
  text-align: center;
  padding: 80rpx 30rpx;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}